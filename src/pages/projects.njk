<header  class="project" style="background-image: url('/assets/imgs/{{ project.slug }}/{{ project.logo.src }}');">

    <a href="/index.html" title="Aller à la page d'accueil"></a>

    <span></span>

    <aside>

        <h1><small>Navigation</small></h1>
        <a class="btn btn-projects-nav --reverse" href="/projets/{{ projects | navSlug(project.slug, -1) }}.html" title="Allez au projet précédent">Projet<small>précédent</small></a>
        <a class="btn btn-projects-nav" href="/projets/{{ projects | navSlug(project.slug, 1) }}.html" title="Allez au projet suivant">Projet<small>suivant</small></a>

    </aside>

</header>

<main class="container">

    <!-- SECTION GALERIE -->
    <section id="project-details">

        <h2 class="">{{ project.client.name }}<small>{{ project.year }} - {{ project.name }}</small></h2>

        <header>
            <!-- banner -->
            <img src="/assets/imgs/{{ project.slug }}/{{ project.banner.src }}"
                 alt="{{ project.banner.description }}" width="810" height="512">

            <aside>

                <section>
                    {% if "Graphisme" in project.categories %}
                        <img alt="Création graphique" src="/assets/svgs/picto-creation-graphique.svg">
                    {% endif %}
                    {% if "Site internet" in project.categories %}
                        <img alt="Site Internet" src="/assets/svgs/picto-creation-site.svg">
                    {% endif %}
                    {% if "Développement" in project.categories %}
                        <img alt="Site Internet" src="/assets/svgs/picto-labo.svg">
                    {% endif %}
                </section>

                <ul class="tags-list">
                    {% for tag in project.tags %}
                        <li>{{ tag }}</li>
                    {% endfor %}
                </ul>

                <p>
                    {% if project.description.length > 0 %}
                        {% for paragraph in project.description %}
                            {{ paragraph }}<br/>
                        {% endfor %}
                    {% endif %}
                </p>

            </aside>

            {% if project.url %}
                <a class="btn btn-page-nav" href="{{ project.url }}" target="_blank">Voir le site</a>
            {% endif %}

        </header>

        <section class="masonry-container">

            {% for image in project.images %}
                    <img alt="" src="/assets/imgs/{{ project.slug }}/{{ image.src }}" >
            {% endfor %}

        </section>

    </section>

    <!-- SECTION PROJETS -->
    {% from "components/slider.njk" import slider %}
    {{ slider(
        "projets",
        "Projets",
        "Similaires",
        project | sortbyrelatedness(projects)
    ) }}

    <!-- SECTION CONTACT -->
    <section id="contact">

        <h2>Vous avez un projet ?</h2>

        <h3>N’hésitez pas à nous
            <a class="btn btn-page-nav" href="/pages/contact.html" title="Prenez contact par email">Contacter</a>
        </h3>

    </section>

</main>
